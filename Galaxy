<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مجرّة الروايات</title>
    <!-- استدعاء مكتبة Tailwind CSS للتصميم الاحترافي -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- استدعاء مكتبة الخلفية المتحركة -->
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    <!-- استدعاء أيقونات FontAwesome للوجوهات مثل جوجل -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-950 h-screen overflow-x-hidden font-sans text-gray-100 flex flex-col justify-between">

    <!-- حاوية الخلفية المتحركة -->
    <div id="particles-js" class="absolute inset-0 w-full h-full z-0 opacity-50"></div>

    <!-- الهيدر (شريط العرض العلوي) -->
    <header class="relative z-10 w-full px-6 py-4 flex justify-between items-center bg-gray-900/40 backdrop-blur-md border-b border-gray-800/60">
        <div class="flex items-center gap-3">
            <span class="text-2xl">🌌</span>
            <span class="font-bold text-lg bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-400">مجرّة الروايات</span>
        </div>
        <!-- زر تسجيل الدخول عبر جوجل العلوي -->
        <button onclick="alert('جاري ربط تسجيل الدخول بحساب جوجل... قريباً!')" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/10 px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 backdrop-blur-sm shadow-sm hover:scale-105">
            <i class="fa-brands fa-google text-red-400"></i>
            <span>دخول بـ Google</span>
        </button>
    </header>

    <!-- المحتوى الرئيسي في المنتصف -->
    <main class="relative z-10 flex flex-col items-center justify-center flex-grow px-4 my-8">
        
        <div class="bg-gray-900/60 backdrop-blur-xl p-8 rounded-3xl shadow-2xl border border-gray-800 max-w-lg w-full text-center">
            
            <h1 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-500 mb-4 tracking-wide">
                مجرّة الروايات
            </h1>
            <p class="text-gray-400 text-sm mb-6">بوابتك العبقرية لعوالم الفانتازيا، الغموض، والتشويق.</p>
            
            <!-- شريط البحث -->
            <div class="relative mb-6">
                <input type="search" placeholder="ابحث عن روايتك المفضلة (لورد الغوامض، القس المجنون...)" 
                       class="w-full px-5 py-3.5 bg-gray-800/80 text-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none placeholder-gray-500 text-sm transition-all border border-gray-700/50 shadow-inner">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
            </div>

            <!-- أزرار الروايات السريعة -->
            <div class="grid grid-cols-2 gap-3 mb-6">
                <a href="#" class="bg-blue-600/80 hover:bg-blue-600 text-white py-3 px-4 rounded-xl font-medium text-sm transition-all duration-300 shadow-lg shadow-blue-900/20 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-book-open"></i> لورد الغوامض
                </a>
                <a href="#" class="bg-purple-600/80 hover:bg-purple-600 text-white py-3 px-4 rounded-xl font-medium text-sm transition-all duration-300 shadow-lg shadow-purple-900/20 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-fire"></i> القس المجنون
                </a>
            </div>

            <!-- زر تسجيل دخول إضافي بارز -->
            <button onclick="alert('جاري فتح نافذة المصادقة مع Google...')" class="w-full py-3 px-4 bg-gradient-to-r from-gray-800 to-gray-700 hover:from-gray-700 hover:to-gray-600 border border-gray-600/50 rounded-2xl font-medium text-sm flex items-center justify-center gap-3 transition-all duration-300 shadow-md group">
                <i class="fa-brands fa-google text-red-500 text-lg group-hover:scale-110 transition-transform"></i>
                <span>متابعة باستخدام حساب Google</span>
            </button>
        </div>
    </main>

    <!-- التذييل السفلي -->
    <footer class="relative z-10 text-center py-4 text-gray-500 text-xs border-t border-gray-900 bg-gray-950/80">
        جميع الحقوق محفوظة © 2026 - مجرّة الروايات
    </footer>

    <!-- سكربت تشغيل الخلفية المتحركة -->
    <script>
        particlesJS('particles-js', {
            particles: {
                number: { value: 70, density: { enable: true, value_area: 800 } },
                color: { value: '#a855f7' },
                shape: { type: 'circle' },
                opacity: { value: 0.4, random: true },
                size: { value: 3, random: true },
                line_linked: { enable: true, distance: 150, color: '#3b82f6', opacity: 0.2, width: 1 },
                move: { enable: true, speed: 1.5, direction: 'none', out_mode: 'out' }
            },
            interactivity: {
                detect_on: 'canvas',
                events: { onhover: { enable: true, mode: 'grab' }, onclick: { enable: true, mode: 'push' }, resize: true }
            },
            retina_detect: true
        });
    </script>
</body>
</html>
